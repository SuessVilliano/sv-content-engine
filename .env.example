# Copy to .env and fill in. NEVER commit real values — .env is gitignored.
# Load it before launching, e.g.:  set -a; source .env; set +a; python3 launch.py

# ── Dashboard access ─────────────────────────────────────────────────────────
# Required if you bind beyond localhost (launch.py --lan). Requests must send it
# as the  X-SV-Token  header or  ?token=  query param.
SV_DASHBOARD_TOKEN=
# Bind host/port (defaults: 127.0.0.1 : 4444). Prefer launch.py --lan over SV_HOST.
# SV_HOST=127.0.0.1
# SV_PORT=4444
# SV_MAX_UPLOAD_MB=300
# SV_MAX_CONCURRENT_JOBS=2

# ── Generation / publishing credentials (rotate any that ever leaked) ────────
ANTHROPIC_API_KEY=
FAL_API_KEY=
HEYGEN_API_KEY=
GHL_PIT_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
OPUS_CLIP_API_KEY=
# Non-secret identifiers (override only if your account differs)
# GHL_LOCATION_ID=
# GHL_USER_ID=
# R2_ACCOUNT_ID=

# ── Avatar (opt-in; off by default so it never spends credits unexpectedly) ──
# SV_ENABLE_AVATAR=1     # set the brand's avatar.talking_photo_id + heygen_voice_id too

# ── Service URLs (override if not on the defaults) ───────────────────────────
# VOXCPM_URL=http://localhost:8808
# COMFYUI_URL=http://localhost:8188
